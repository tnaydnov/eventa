{
  "git": {
    "deploymentEnabled": false
  },
  "regions": ["fra1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 15
    },
    "src/app/api/payment/create-session/route.ts": {
      "maxDuration": 25
    },
    "src/app/api/payment/callback/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/requests/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cleanup/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/auto-archive/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/cleanup-orphan-photos/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
