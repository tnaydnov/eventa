# ─── Supabase ───
# For local dev: http://127.0.0.1:54321 / keys from `supabase status`
# For production: Your Supabase project URL & keys from supabase.com dashboard
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth & Security ───
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate-a-long-random-string-here
ADMIN_PASSWORD=change-this-in-production

# ─── Cron ───
# Vercel auto-sets this for Vercel Cron jobs.
# For local testing, generate your own:
CRON_SECRET=generate-another-random-string
