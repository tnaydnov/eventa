# =============================================================================
#  ENVIRONMENT CONFIGURATION
# =============================================================================
#  Copy this file to `.env.local` and fill in the values you need:
#      cp .env.example .env.local
#
#  Legend:
#    [REQUIRED]  the app will not start / build without it
#    [OPTIONAL]  the related feature is disabled or stubbed when unset
#
#  `NEXT_PUBLIC_*` variables are inlined into the browser bundle at build time.
#  NEVER put a secret in a `NEXT_PUBLIC_*` variable.
#
#  See README.md -> "Configuration reference" for the full explanation.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. BRANDING & PUBLIC IDENTITY   (resolved in src/config/site.ts)
# -----------------------------------------------------------------------------

# [REQUIRED in production] Canonical public origin, no trailing slash.
# Drives canonical tags, sitemap, robots.txt, Open Graph, QR/join links,
# e-mail links and the JWT `iss` claim. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [OPTIONAL] Product name shown in the UI, e-mails and SMS. Default: Eventa
NEXT_PUBLIC_BRAND_NAME=Eventa
NEXT_PUBLIC_BRAND_TAGLINE=Turn Any Event Into an Experience
NEXT_PUBLIC_BRAND_DESCRIPTION=Smart social layers for live events - matchmaking, networking and audience engagement.

# [OPTIONAL] Public contact channels. Any left blank is hidden from the UI
# (footer icons, legal pages, FAQ, security.txt, e-mail footers).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# [OPTIONAL] Legal operator identity printed on the terms / privacy / cookies
# / B2B pages. Defaults to NEXT_PUBLIC_BRAND_NAME.
#   NEXT_PUBLIC_LEGAL_ENTITY_NAME  e.g. "Acme Ltd."
#   NEXT_PUBLIC_LEGAL_ENTITY_FORM  e.g. "company no. 123456789"
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_FORM=
NEXT_PUBLIC_ACCESSIBILITY_CONTACT_NAME=


# -----------------------------------------------------------------------------
#  2. SUPABASE   (database, session storage, realtime, file storage)
# -----------------------------------------------------------------------------
#  Create a project at https://supabase.com, then Project Settings -> API.
#  Local dev: run `supabase start` and copy the values from `supabase status`.

# [REQUIRED]
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# [REQUIRED] Publishable / anon key - safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# [REQUIRED for API routes, cron and admin] Server-only. NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# -----------------------------------------------------------------------------
#  3. AUTH & SECURITY SECRETS
# -----------------------------------------------------------------------------
#  Generate each with:
#    node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# [REQUIRED] Signs guest session + admin JWTs. Minimum 32 characters.
JWT_SECRET=

# [REQUIRED for /admin] Admin console password (min 12 chars).
# Prefer ADMIN_PASSWORD_HASH (scrypt) over plaintext in production.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# [OPTIONAL] Base32 TOTP secret to require 2FA on admin login.
ADMIN_TOTP_SECRET=

# [OPTIONAL] Set to 'false' to stop persisting admin audit log rows.
ADMIN_AUDIT_PERSIST=true

# [REQUIRED for cron routes] Bearer token every /api/cron/* route checks.
# Vercel injects this automatically for Vercel Cron; set it yourself locally.
CRON_SECRET=

# [OPTIONAL but STRONGLY RECOMMENDED] Application-level encryption of stored
# PII (phone numbers, e-mails). Each must be 32 random bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_ENCRYPTION_KEY encrypts; BLIND_INDEX_KEY makes encrypted values
# searchable. Losing them makes existing encrypted rows unreadable.
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# Set during key rotation so old ciphertexts stay readable.
FIELD_ENCRYPTION_KEY_OLD=

# [OPTIONAL] Extra secret mixed into OTP hashes.
OTP_PEPPER=

# [OPTIONAL] Slack/Discord/webhook URL that receives security alerts.
SECURITY_ALERT_WEBHOOK_URL=


# -----------------------------------------------------------------------------
#  4. RATE LIMITING   (Upstash Redis - optional, recommended on serverless)
# -----------------------------------------------------------------------------
#  Without these the limiter falls back to an in-memory store, which resets on
#  every cold start and is NOT shared between serverless instances.
#  Create a free database at https://upstash.com -> REST API tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# -----------------------------------------------------------------------------
#  5. EMAIL   (SMTP via Nodemailer)
# -----------------------------------------------------------------------------
#  Used for order confirmations, invoices, upload reminders and post-event
#  reports. Leave blank to disable outbound e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# [OPTIONAL] Envelope From address. Defaults to SMTP_USER.
SMTP_FROM=
# [OPTIONAL] Mailbox that receives internal operator notifications
# (new orders, payments, contact requests). Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
ADMIN_NOTIFICATION_EMAIL=


# -----------------------------------------------------------------------------
#  6. SMS PROVIDER   (OTP codes + guest notifications)
# -----------------------------------------------------------------------------
#  The bundled adapter targets TextMe (https://docs.textme.co.il).
#  With SMS_PROVIDER_LIVE=false every send is logged and stubbed - no cost and
#  no real delivery. See src/lib/messaging/sms-provider.ts to swap providers.
SMS_PROVIDER_LIVE=false
TEXTME_API_TOKEN=
TEXTME_USERNAME=
# Sender name shown on the SMS. Max 11 characters.
TEXTME_SENDER_NAME=Eventa


# -----------------------------------------------------------------------------
#  7. PAYMENTS & INVOICING   (Invoice4U)
# -----------------------------------------------------------------------------
#  With PAYMENT_PROVIDER_LIVE=false the checkout flow is stubbed.
#  Token: Invoice4U dashboard -> Settings -> API.
PAYMENT_PROVIDER_LIVE=false
INVOICE4U_API_TOKEN=
# Override for the sandbox: https://apiqa.invoice4u.co.il/Services/ApiService.svc
INVOICE4U_API_URL=


# -----------------------------------------------------------------------------
#  8. AI CONTENT MODERATION   (optional)
# -----------------------------------------------------------------------------
#  Without a key, uploaded photos are auto-approved and AI report summaries are
#  skipped. Both features fail open by design.

# OpenAI - image/text moderation + post-event report summaries.
OPENAI_API_KEY=

# Falconsai NSFW detector - optional second opinion for borderline photos.
# Self-host it, or point at the HuggingFace inference endpoint.
FALCONSAI_ENDPOINT=
FALCONSAI_TOKEN=


# -----------------------------------------------------------------------------
#  9. FEATURE FLAGS & TUNING   (optional - defaults live in src/lib/config.ts)
# -----------------------------------------------------------------------------

# Set to 'false' to let guests join without SMS verification (useful in dev).
NEXT_PUBLIC_PHONE_VERIFICATION_ENABLED=true

# OTP behaviour
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Anti SMS-pumping guards.
OTP_MAX_PER_PHONE_PER_HOUR=20
# Global 24h cap across all phones. 0 = disabled.
OTP_GLOBAL_MAX_PER_DAY=0

# Logging: debug | info | warn | error
LOG_LEVEL=


# -----------------------------------------------------------------------------
#  10. ANALYTICS   (optional - no tag is injected at all when left blank)
# -----------------------------------------------------------------------------
# Google Ads conversion ID, e.g. AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
