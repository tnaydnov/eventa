# ─── Supabase ───
# For local dev: http://127.0.0.1:54321 / keys from `supabase status`
# For production: Your Supabase project URL & keys from supabase.com dashboard
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ───
# Production URL
NEXT_PUBLIC_SITE_URL=https://eventa.productions

# ─── Auth & Security ───
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate-a-long-random-string-here
ADMIN_PASSWORD=change-this-in-production

# ─── Cron ───
# Vercel auto-sets this for Vercel Cron jobs.
# For local testing, generate your own:
CRON_SECRET=generate-another-random-string

# ─── Email (SMTP) ───
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@eventa.productions

# ─── SMS Provider (TextMe) ───
# Generate token: https://docs.textme.co.il/guide/#generate-api-token
# Optional - stubs used when SMS_PROVIDER_LIVE=false
TEXTME_API_TOKEN=your-textme-api-token
TEXTME_USERNAME=your-textme-username
TEXTME_SENDER_NAME=Eventa

# ─── Invoice4U (Payment & Invoicing) ───
# GUID token from Invoice4U Settings → API
INVOICE4U_API_TOKEN=your-invoice4u-api-token
# Override for staging: https://apiqa.invoice4u.co.il/Services/ApiService.svc
# INVOICE4U_API_URL=https://api.invoice4u.co.il/Services/ApiService.svc

# ─── Feature Flags ───
# Set to 'true' to enable live providers instead of stubs
SMS_PROVIDER_LIVE=false
PAYMENT_PROVIDER_LIVE=false

# Set to 'false' to disable phone verification on join page
NEXT_PUBLIC_PHONE_VERIFICATION_ENABLED=true
